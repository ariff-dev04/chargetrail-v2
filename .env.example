# ==============================================================================
# ChargeTrail v2 Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="ChargeTrail v2 API"
API_V1_STR=/api/v1

# PostgreSQL 16 + PostGIS Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chargetrail

# Async Database Connection URL (AsyncPG driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chargetrail

# Allowed CORS Origins (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]

# Open-Source External Services ($0 Free Tech Stack)
OSRM_BASE_URL=http://router.project-osrm.org
PHOTON_GEOCODE_URL=https://photon.komoot.io/api
